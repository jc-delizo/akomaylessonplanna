# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_EMAIL=support@example.com

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email delivery and signed webhook processing
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Ako may lesson plan na! <noreply@example.com>
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Privileged endpoint secrets (generate independent random values)
# Example: openssl rand -hex 32
CREATE_SUPER_ADMIN_SECRET=replace-with-a-random-secret
CRON_SECRET=replace-with-a-different-random-secret
# Keep false until provider-side initiation and end-to-end payment tests are complete.
PAYMENTS_ENABLED=false
GCASH_WEBHOOK_SECRET=replace-with-your-gcash-webhook-secret
MAYA_WEBHOOK_SECRET=replace-with-your-maya-webhook-secret

# OAuth
NEXT_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional cache
REDIS_URL=

# Optional production migration scripts
PROD_NEXT_PUBLIC_SUPABASE_URL=
PROD_SUPABASE_SERVICE_ROLE_KEY=
